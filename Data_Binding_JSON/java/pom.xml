<?xml version="1.0" encoding="UTF-8"?>
<!--
  Native Java data binding for FundsXML (DOM + XPath into records, no JAXB).
  Pure JDK, no third-party dependencies.

  Run from the repo root:
    ./mvnw -q -pl Data_Binding_JSON/java compile exec:java \
        -Dexec.args="FundsXML_Files/4.2.9/positions/Mixed-Fund_Positions.xml"
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.fundsxml.examples</groupId>
    <artifactId>fundsxml-examples</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>data-binding-java</artifactId>
  <properties>
    <exec.mainClass>NativeBinding</exec.mainClass>
  </properties>

  <build>
    <sourceDirectory>${project.basedir}</sourceDirectory>
  </build>
</project>
