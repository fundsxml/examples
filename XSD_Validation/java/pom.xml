<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD validation in native Java (javax.xml.validation, no JAXB). No third-party
  dependencies at all: the JDK is the whole runtime. Because of that, Maven is
  NOT required to run this example. The JDK's source launcher (JDK 11+) does it
  in one call from the repo root:
    java XSD_Validation/java/XsdValidate.java <schema> <xml-file>
  where <schema> is a local FundsXML.xsd path or a remote URL, see
  XsdValidate.java.

  This module exists only so the root aggregator (./mvnw compile, CI) builds
  every Java example uniformly. The equivalent Maven invocation is:
    ./mvnw -q -pl XSD_Validation/java compile exec:java \
        -Dexec.args="<schema> <xml-file>"
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.fundsxml.examples</groupId>
    <artifactId>fundsxml-examples</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>xsd-validation-java</artifactId>
  <properties>
    <exec.mainClass>XsdValidate</exec.mainClass>
  </properties>

  <build>
    <!-- Keep the single teaching source where the README points it. -->
    <sourceDirectory>${project.basedir}</sourceDirectory>
  </build>
</project>
