<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD validation in native Java (javax.xml.validation, no JAXB). No third-party
  dependencies — the JDK is the whole runtime. The schema is obtained by the
  example itself (env var / local cache / official download), see XsdValidate.java.

  Run from the repo root:
    ./mvnw -q -pl XSD_Validation/java compile exec:java \
        -Dexec.args="4.2.9 FundsXML_Files/4.2.9/positions/Mixed-Fund_Positions.xml"
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.fundsxml.examples</groupId>
    <artifactId>fundsxml-examples</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>xsd-validation-java</artifactId>
  <properties>
    <exec.mainClass>XsdValidate</exec.mainClass>
  </properties>

  <build>
    <!-- Keep the single teaching source where the README points it. -->
    <sourceDirectory>${project.basedir}</sourceDirectory>
  </build>
</project>
