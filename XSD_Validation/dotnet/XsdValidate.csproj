<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal console project (XsdValidate.cs only). Run from the repo root
       with "dotnet run", the project switch pointing at XSD_Validation/dotnet,
       then the two arguments <schema> <xml-file>; the exact command line is in
       the XsdValidate.cs header (XML comments cannot contain a double dash). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>XsdValidate</AssemblyName>
    <RootNamespace>FundsXml.XsdValidation</RootNamespace>
  </PropertyGroup>
</Project>
